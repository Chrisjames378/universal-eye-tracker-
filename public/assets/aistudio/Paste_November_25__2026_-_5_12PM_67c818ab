        function handleTargetActivation(el) {
            const action = el.getAttribute('data-action');
            const openApp = el.getAttribute('data-open-app');
            const typeText = el.getAttribute('data-type');
            const assistiveCmd = el.getAttribute('data-assistive');

            playFeedbackSound('tap');

            // Record Fixation Point for Heatmap Visualization
            const phoneRect = heatmapCanvas.parentElement.getBoundingClientRect();
            if (
                state.smoothGaze.x >= phoneRect.left &&
                state.smoothGaze.x <= phoneRect.right &&
                state.smoothGaze.y >= phoneRect.top &&
                state.smoothGaze.y <= phoneRect.bottom
            ) {
                state.fixationPoints.push({
                    x: state.smoothGaze.x - phoneRect.left,
                    y: state.smoothGaze.y - phoneRect.top,
                    r: 28,
                    alpha: 0.75
                });
                if (state.fixationPoints.length > 25) state.fixationPoints.shift();
            }

            // Tactile visual pulse on reticle
            reticleDot.style.transform = 'scale(1.8)';
            setTimeout(() => reticleDot.style.transform = 'scale(1)', 180);

            // Top-Right Hot Corner Screenshot Capture
            if (el.id === 'hot-corner-tr') {
                recordPhotoCapture('Screen Capture');
                showIOSToast('Screenshot Captured', 'Saved to Gaze Photos');
                return;
            }

            // AssistiveTouch Floating Orb & Radial Modal Actions
            if (el.id === 'assistive-orb') {
                document.getElementById('assistive-modal').classList.toggle('hidden');
                return;
            }
            if (el.id === 'close-assistive-btn') {
                document.getElementById('assistive-modal').classList.add('hidden');
                return;
            }
            if (el.id === 'hot-corner-tl' || el.id === 'open-cc-icon') {
                document.getElementById('control-center-drawer').classList.remove('hidden');
                showIOSToast('Control Center', 'Dwell on sliders or toggles');
                return;
            }
            if (el.id === 'close-cc-btn') {
                document.getElementById('control-center-drawer').classList.add('hidden');
                return;
            }
            if (el.id === 'cc-bright-up' || el.id === 'cc-bright-down') {
                state.brightness = Math.min(100, Math.max(20, state.brightness + (el.id === 'cc-bright-up' ? 20 : -20)));
                document.getElementById('cc-bright-val').textContent = `${state.brightness}%`;
                document.getElementById('screen-dimmer').style.opacity = ((100 - state.brightness) / 130).toFixed(2);
                return;
            }
            if (el.id === 'cc-vol-up' || el.id === 'cc-vol-down') {
                state.volume = Math.min(100, Math.max(0, state.volume + (el.id === 'cc-vol-up' ? 15 : -15)));
                document.getElementById('cc-vol-val').textContent = `${state.volume}%`;
                return;
            }
            if (el.id === 'cc-wifi' || el.id === 'cc-bt' || el.id === 'cc-dnd') {
                el.classList.toggle('opacity-40');
                showIOSToast(action, 'Toggled via Gaze');
                return;
            }
            if (assistiveCmd) {
                document.getElementById('assistive-modal').classList.add('hidden');
                if (assistiveCmd === 'home') {
                    switchPhoneView('view-home');
                } else if (assistiveCmd === 'reader') {
                    switchPhoneView('view-safari');
                } else if (assistiveCmd === 'control') {
                    document.getElementById('control-center-drawer').classList.remove('hidden');
                } else if (assistiveCmd === 'screenshot') {
                    recordPhotoCapture('Assistive Capture');
                } else if (assistiveCmd === 'pause') {
                    state.gazePaused = !state.gazePaused;
                    document.getElementById('assistive-pause-label').textContent = state.gazePaused ? 'Resume Gaze' : 'Pause Gaze';
                    showIOSToast(state.gazePaused ? 'Gaze Paused' : 'Gaze Resumed', state.gazePaused ? 'Dwell taps suspended' : 'Active gaze control restored');
                    return;
                }
                showIOSToast(action, 'AssistiveTouch Hardware Trigger');
                return;
            }

            if (openApp) {
                switchPhoneView(`view-${openApp}`);
                if (openApp === 'keyboard') renderKeyboardKeys();
                if (openApp === 'camera') syncCameraAppFeed();
                showIOSToast(action, 'Launched via Eye Tracking');
                return;
