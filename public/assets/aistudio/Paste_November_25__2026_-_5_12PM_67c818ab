        // 9-Point iOS Calibration Routine
        const calibOverlay = document.getElementById('calibration-overlay');
        const calibDot = document.getElementById('calib-dot');
        const calibStatus = document.getElementById('calib-status');
        const calibPoints = [
            { x: 50, y: 50 }, { x: 15, y: 18 }, { x: 85, y: 18 },
            { x: 85, y: 50 }, { x: 85, y: 82 }, { x: 50, y: 82 },
            { x: 15, y: 82 }, { x: 15, y: 50 }, { x: 50, y: 50 }
        ];
        let calibTimer = null;

        function startCalibration() {
            state.isCalibrating = true;
            state.calibStep = 0;
            calibOverlay.classList.remove('hidden');
            calibOverlay.classList.add('flex');
            advanceCalibrationStep();
        }

        function advanceCalibrationStep() {
            if (state.calibStep >= calibPoints.length) {
                finishCalibration();
                return;
            }
            const pt = calibPoints[state.calibStep];
            calibDot.style.left = `${pt.x}%`;
            calibDot.style.top = `${pt.y}%`;
            calibStatus.textContent = `Point ${state.calibStep + 1} of ${calibPoints.length}`;

            clearTimeout(calibTimer);
            calibTimer = setTimeout(() => {
                // Record center offset on final center point
                if (state.calibStep === calibPoints.length - 1 && state.mode === 'webcam') {
                    const targetX = window.innerWidth * 0.5;
                    const targetY = window.innerHeight * 0.5;
                    state.calibrationOffset.x = targetX - (state.irisNorm.x * window.innerWidth);
                    state.calibrationOffset.y = targetY - (state.irisNorm.y * window.innerHeight);
                }
                state.calibStep++;
                advanceCalibrationStep();
            }, 950);
        }

        function finishCalibration() {
            state.isCalibrating = false;
            calibOverlay.classList.add('hidden');
            calibOverlay.classList.remove('flex');
            clearTimeout(calibTimer);
            savePreferences();
            showIOSToast('Calibration Complete', 'Gaze accuracy optimized & saved');
