<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#09090b">
    <title>Universal Eye Tracking & Gaze OS Simulator</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Tone.js for Synthesized iOS Haptic & Audio Feedback -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <!-- MediaPipe Face Mesh for Real-Time Webcam Iris Tracking -->
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/face_mesh/face_mesh.js" crossorigin="anonymous"></script>
    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #09090b;
            color: #f4f4f5;
            overflow-x: hidden;
            user-select: none;
        }

        /* Custom iOS Glassmorphism & Scrollbar */
        .ios-glass {
            background: rgba(28, 28, 30, 0.75);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .ios-wallpaper {
            background: radial-gradient(circle at 20% 20%, #1e1b4b 0%, #0f172a 45%, #020617 100%);
        }

        /* Dwell Ring Animation */
        .dwell-ring-circle {
            transition: stroke-dashoffset 0.05s linear;
            transform: rotate(-90deg);
            transform-origin: 50% 50%;
        }

        /* Gaze Target Highlight Effect (Mimics iOS Accessibility Snap-to-Item) */
        .gaze-target {
            transition: transform 0.2s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.2s ease, border-color 0.2s ease;
        }
        .gaze-target.gaze-hovered {
            transform: scale(1.04);
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.85), 0 10px 25px -5px rgba(56, 189, 248, 0.4);
            z-index: 20;
        }

        /* Custom Range Slider (iOS Style) */
        input[type=range] {
            -webkit-appearance: none;
            background: transparent;
        }
        input[type=range]::-webkit-slider-thumb {
            -webkit-appearance: none;
            height: 20px;
            width: 20px;
            border-radius: 50%;
            background: #ffffff;
            box-shadow: 0 2px 6px rgba(0,0,0,0.4);
            cursor: pointer;
            margin-top: -8px;
        }
        input[type=range]::-webkit-slider-runnable-track {
            width: 100%;
            height: 4px;
            cursor: pointer;
            background: rgba(255,255,255,0.2);
            border-radius: 2px;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col lg:flex-row items-center justify-center p-4 md:p-6 gap-6 relative">

    <!-- Hidden Video Element for Webcam Feed -->
    <video id="webcam-video" class="hidden" playsinline></video>

    <!-- Floating Gaze Reticle (iOS Accessibility Pointer) -->
    <div id="gaze-reticle" class="fixed pointer-events-none z-50 hidden flex items-center justify-center" style="width: 56px; height: 56px; margin-left: -28px; margin-top: -28px;">
        <!-- Outer Dwell Progress SVG -->
        <svg class="w-full h-full drop-shadow-md" viewBox="0 0 60 60">
            <circle cx="30" cy="30" r="24" fill="rgba(56, 189, 248, 0.12)" stroke="rgba(255, 255, 255, 0.25)" stroke-width="3"></circle>
            <circle id="dwell-progress" class="dwell-ring-circle" cx="30" cy="30" r="24" fill="none" stroke="#38bdf8" stroke-width="4" stroke-linecap="round" stroke-dasharray="150.8" stroke-dashoffset="150.8"></circle>
        </svg>
        <!-- Center Pupil Dot -->
        <div id="reticle-dot" class="absolute w-2.5 h-2.5 bg-sky-400 rounded-full shadow-[0_0_8px_#38bdf8] transition-transform duration-150"></div>
    </div>

    <!-- Fullscreen Calibration Overlay (Mimics iOS 10-Point Calibration) -->
    <div id="calibration-overlay" class="fixed inset-0 z-50 bg-black/95 backdrop-blur-xl hidden flex-col items-center justify-center">
        <div class="absolute top-8 text-center px-4">
            <span class="px-3 py-1 rounded-full bg-sky-500/20 text-sky-400 text-xs font-semibold tracking-wider uppercase border border-sky-500/30">iOS Eye Tracking Setup</span>
            <h2 class="text-2xl md:text-3xl font-bold text-white mt-3">Follow the Dot With Your Eyes</h2>
            <p class="text-zinc-400 text-sm mt-1 max-w-md mx-auto">Keep your head steady and focus directly on the glowing circle until it locks in.</p>
        </div>

        <!-- Dynamic Calibration Target Dot -->
        <button id="calib-dot" class="absolute w-12 h-12 -ml-6 -mt-6 rounded-full flex items-center justify-center transition-all duration-500 ease-out cursor-pointer focus:outline-none" style="top: 50%; left: 50%;">
            <span class="absolute inset-0 rounded-full bg-sky-500/30 animate-ping"></span>
            <span class="relative w-6 h-6 rounded-full bg-sky-400 border-2 border-white shadow-[0_0_20px_#38bdf8]"></span>
        </button>

        <div class="absolute bottom-10 flex flex-col items-center gap-3">
            <div class="text-sm font-medium text-zinc-300" id="calib-status">Point 1 of 9</div>
            <button id="cancel-calib-btn" class="px-5 py-2 rounded-full bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-sm font-medium transition">
                Cancel Calibration
            </button>
        </div>
    </div>

    <!-- LEFT PANEL: Telemetry, Camera Feed & iOS Accessibility Settings -->
    <aside class="w-full max-w-md lg:w-96 flex flex-col gap-4 z-10">
        <!-- Header Card -->
        <div class="ios-glass rounded-3xl p-5 shadow-2xl">
            <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-sky-400 to-blue-600 flex items-center justify-center shadow-lg shadow-sky-500/20">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                    </div>
                    <div>
                        <h1 class="font-bold text-lg text-white leading-tight">Eye Tracking OS</h1>
                        <p class="text-xs text-zinc-400">Universal Gaze & Assistive Suite</p>
                    </div>
                </div>
                <span id="tracking-badge" class="px-2.5 py-1 rounded-full text-xs font-medium bg-amber-500/20 text-amber-300 border border-amber-500/30">
                    Simulator Mode
                </span>
            </div>

            <!-- Cross-Platform Device Profile Selector (PC, Surface Pro 6, Oppo A6x) -->
            <div class="mt-3">
                <div class="flex items-center justify-between text-[11px] text-zinc-400 mb-1.5">
                    <span class="font-medium uppercase tracking-wider">Hardware & Camera Profile</span>
                    <span id="device-optics-hint" class="text-sky-400 font-mono">16:9 • 1080p</span>
                </div>
                <div class="grid grid-cols-3 gap-1.5 p-1 bg-black/40 rounded-xl border border-white/5">
                    <button data-device="pc" class="device-profile-btn py-1.5 px-2 rounded-lg text-[11px] font-semibold bg-sky-500/25 text-sky-300 border border-sky-500/40 transition">
                        Desktop PC
                    </button>
                    <button data-device="surface" class="device-profile-btn py-1.5 px-2 rounded-lg text-[11px] font-semibold text-zinc-400 hover:text-white transition">
                        Surface Pro 6
                    </button>
                    <button data-device="oppo" class="device-profile-btn py-1.5 px-2 rounded-lg text-[11px] font-semibold text-zinc-400 hover:text-white transition">
                        Oppo A6x
                    </button>
                </div>
            </div>

            <!-- Input Source Switcher -->
            <div class="grid grid-cols-2 gap-2 p-1 bg-black/40 rounded-xl border border-white/5 mt-3">
                <button id="mode-sim-btn" class="py-2 px-3 rounded-lg text-xs font-semibold bg-zinc-800 text-white shadow transition">
                    Cursor / Touch Sim
                </button>
                <button id="mode-cam-btn" class="py-2 px-3 rounded-lg text-xs font-semibold text-zinc-400 hover:text-white transition flex items-center justify-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                    Live Webcam AI
                </button>
            </div>

            <!-- Accessibility Quick Presets -->
            <div class="grid grid-cols-3 gap-1.5 mt-3">
                <button data-preset="beginner" class="preset-btn py-1.5 px-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-[10px] font-semibold text-zinc-300 transition">
                    Stable (1.4s)
                </button>
                <button data-preset="pro" class="preset-btn py-1.5 px-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-[10px] font-semibold text-sky-300 transition">
                    Fast Pro (0.6s)
                </button>
                <button data-preset="blink" class="preset-btn py-1.5 px-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-[10px] font-semibold text-emerald-300 transition">
                    Blink-Only
                </button>
            </div>
        </div>

        <!-- Iris & Head Telemetry Visualizer -->
        <div class="ios-glass rounded-3xl p-5 shadow-2xl">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-semibold uppercase tracking-wider text-zinc-400">Biometric Iris Telemetry</span>
                <span id="fps-counter" class="text-xs font-mono text-sky-400">60 FPS</span>
            </div>
            
            <!-- Canvas for Eye Mesh / Simulated Dual Iris Vector Display -->
            <div class="relative w-full h-36 bg-black/60 rounded-2xl overflow-hidden border border-white/10 flex items-center justify-center">
                <canvas id="telemetry-canvas" class="w-full h-full"></canvas>
                <div id="cam-loading-msg" class="hidden absolute inset-0 bg-black/80 flex flex-col items-center justify-center text-center p-4">
                    <div class="w-6 h-6 border-2 border-sky-400 border-t-transparent rounded-full animate-spin mb-2"></div>
                    <p class="text-xs text-zinc-300">Initializing Neural Iris Tracker...</p>
                </div>
            </div>

            <!-- Live Coordinates -->
            <div class="grid grid-cols-3 gap-2 mt-3 text-center">
                <div class="bg-white/5 rounded-xl p-2">
                    <div class="text-[10px] text-zinc-400 uppercase">Gaze X</div>
                    <div id="stat-x" class="text-xs font-mono font-semibold text-white mt-0.5">50.0%</div>
                </div>
                <div class="bg-white/5 rounded-xl p-2">
                    <div class="text-[10px] text-zinc-400 uppercase">Gaze Y</div>
                    <div id="stat-y" class="text-xs font-mono font-semibold text-white mt-0.5">50.0%</div>
                </div>
                <div class="bg-white/5 rounded-xl p-2">
                    <div class="text-[10px] text-zinc-400 uppercase">Confidence</div>
                    <div id="stat-conf" class="text-xs font-mono font-semibold text-emerald-400 mt-0.5">99%</div>
                </div>
            </div>
        </div>

        <!-- iOS Accessibility Controls -->
        <div class="ios-glass rounded-3xl p-5 shadow-2xl flex flex-col gap-4">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-sm font-medium text-white">Dwell Control</div>
                    <div class="text-xs text-zinc-400">Auto-tap after holding gaze</div>
                </div>
                <button id="toggle-dwell" class="w-12 h-7 rounded-full bg-emerald-500 p-1 transition-colors duration-200 flex items-center justify-end">
                    <span class="w-5 h-5 rounded-full bg-white shadow"></span>
                </button>
            </div>

            <!-- Dwell Time Slider -->
            <div>
                <div class="flex justify-between text-xs mb-1.5">
                    <span class="text-zinc-300">Dwell Duration</span>
                    <span id="dwell-val-label" class="font-mono text-sky-400">1.0s</span>
                </div>
                <input id="dwell-slider" type="range" min="0.4" max="2.5" step="0.1" value="1.0" class="w-full">
            </div>

            <!-- Smoothing / Stabilization Slider -->
            <div>
                <div class="flex justify-between text-xs mb-1.5">
                    <span class="text-zinc-300">Gaze Smoothing (Anti-Jitter)</span>
                    <span id="smooth-val-label" class="font-mono text-sky-400">High</span>
                </div>
                <input id="smooth-slider" type="range" min="0.05" max="0.45" step="0.05" value="0.15" class="w-full">
            </div>

            <!-- Snap to Item Toggle -->
            <div class="flex items-center justify-between pt-1 border-t border-white/10">
                <div>
                    <div class="text-sm font-medium text-white">Snap to Item</div>
                    <div class="text-xs text-zinc-400">Magnetically lock onto UI buttons</div>
                </div>
                <button id="toggle-snap" class="w-12 h-7 rounded-full bg-emerald-500 p-1 transition-colors duration-200 flex items-center justify-end">
                    <span class="w-5 h-5 rounded-full bg-white shadow"></span>
                </button>
            </div>

            <!-- Head-Pose + Eye Fusion Toggle -->
            <div class="flex items-center justify-between pt-1 border-t border-white/10">
                <div>
                    <div class="text-sm font-medium text-white">Head-Pose + Iris Fusion</div>
                    <div class="text-xs text-zinc-400">Blend subtle head tilt for corner reach</div>
                </div>
                <button id="toggle-headpose" class="w-12 h-7 rounded-full bg-emerald-500 p-1 transition-colors duration-200 flex items-center justify-end">
                    <span class="w-5 h-5 rounded-full bg-white shadow"></span>
                </button>
            </div>

            <!-- Blink-to-Click & Sound / Heatmap Toggles -->
            <div class="grid grid-cols-3 gap-2 pt-2 border-t border-white/10">
                <button id="toggle-blink" class="py-2 px-2 rounded-xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 text-[11px] font-semibold flex flex-col items-center justify-center gap-0.5 transition">
                    <span>Blink Click</span>
                    <span id="blink-status-label" class="text-[9px] uppercase tracking-wider opacity-80">ON (B Key)</span>
                </button>
                <button id="toggle-sound" class="py-2 px-2 rounded-xl bg-sky-500/20 border border-sky-500/40 text-sky-300 text-[11px] font-semibold flex flex-col items-center justify-center gap-0.5 transition">
                    <span>Audio Ticks</span>
                    <span id="sound-status-label" class="text-[9px] uppercase tracking-wider opacity-80">ON</span>
                </button>
                <button id="toggle-heatmap" class="py-2 px-2 rounded-xl bg-white/5 border border-white/10 text-zinc-400 text-[11px] font-semibold flex flex-col items-center justify-center gap-0.5 transition">
                    <span>Saccade Map</span>
                    <span id="heatmap-status-label" class="text-[9px] uppercase tracking-wider opacity-80">OFF</span>
                </button>
            </div>

            <!-- Calibrate Action Button -->
            <button id="start-calib-btn" class="w-full py-3 rounded-2xl bg-sky-500 hover:bg-sky-400 active:scale-[0.98] text-white font-semibold text-sm shadow-lg shadow-sky-500/25 transition flex items-center justify-center gap-2 mt-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Calibrate Eye Tracking
            </button>
        </div>
    <!-- RIGHT PANEL: Interactive Adaptive Device Viewport (iOS / Surface / Oppo A6x) -->
    <main class="flex flex-col items-center justify-center w-full max-w-[420px]">
        <!-- Hardware Bezel -->
        <div id="device-bezel" class="relative w-full max-w-[390px] h-[760px] rounded-[54px] bg-zinc-900 p-3 shadow-[0_0_0_2px_#3f3f46,0_25px_70px_-15px_rgba(0,0,0,0.9)] flex flex-col transition-all duration-300">
            
            <!-- Screen Container -->
            <div id="iphone-screen" class="relative w-full h-full rounded-[42px] ios-wallpaper overflow-hidden flex flex-col justify-between p-5 transition-all duration-300">
                
                <!-- Screen Brightness Dimmer Overlay (Controlled by Control Center) -->
                <div id="screen-dimmer" class="absolute inset-0 bg-black pointer-events-none z-10 transition-opacity duration-200" style="opacity: 0;"></div>

                <!-- Gaze Saccade Trail & Fixation Heatmap Overlay Canvas -->
                <canvas id="heatmap-canvas" class="absolute inset-0 w-full h-full pointer-events-none z-30 hidden"></canvas>

                <!-- AssistiveTouch Hot Corners (Top-Left: Control Center, Top-Right: Screenshot) -->
                <button id="hot-corner-tl" data-action="Hot Corner: Control Center" title="Gaze Hot Corner: Control Center" class="gaze-target absolute top-0 left-0 w-12 h-12 rounded-br-3xl bg-sky-400/5 hover:bg-sky-400/20 border-b border-r border-white/10 z-20 flex items-center justify-center opacity-60 hover:opacity-100">
                    <span class="w-1.5 h-1.5 rounded-full bg-sky-400/70"></span>
                </button>
                <button id="hot-corner-tr" data-action="Hot Corner: Screenshot Captured" title="Gaze Hot Corner: Screenshot" class="gaze-target absolute top-0 right-0 w-12 h-12 rounded-bl-3xl bg-sky-400/5 hover:bg-sky-400/20 border-b border-l border-white/10 z-20 flex items-center justify-center opacity-60 hover:opacity-100">
                    <span class="w-1.5 h-1.5 rounded-full bg-sky-400/70"></span>
                </button>

                <!-- Floating AssistiveTouch Orb (Mimics iOS Eye Tracking AssistiveTouch Menu Trigger) -->
                <button id="assistive-orb" data-action="Toggle AssistiveTouch Menu" class="gaze-target absolute right-3 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-zinc-900/85 backdrop-blur-md border border-white/25 shadow-[0_4px_20px_rgba(0,0,0,0.6)] z-30 flex items-center justify-center">
                    <div class="w-8 h-8 rounded-full bg-white/15 flex items-center justify-center">
                        <div class="w-5 h-5 rounded-full bg-white/80 shadow-inner"></div>
                    </div>
                </button>

                <!-- AssistiveTouch Radial Hardware Modal -->
                <div id="assistive-modal" class="hidden absolute inset-6 m-auto h-72 ios-glass rounded-[36px] p-5 z-40 flex flex-col items-center justify-between shadow-2xl border border-white/20">
                    <div class="text-xs font-semibold tracking-wider uppercase text-sky-400">AssistiveTouch</div>
                    <div class="grid grid-cols-3 gap-3 w-full">
                        <button data-assistive="home" data-action="Hardware Home" class="gaze-target flex flex-col items-center gap-1.5 p-2.5 rounded-2xl bg-white/10 hover:bg-white/20">
                            <div class="w-9 h-9 rounded-full border-2 border-white flex items-center justify-center"><div class="w-3.5 h-3.5 rounded-sm border border-white"></div></div>
                            <span class="text-[11px] font-medium text-white">Home</span>
                        </button>
                        <button data-assistive="control" data-action="Control Center" class="gaze-target flex flex-col items-center gap-1.5 p-2.5 rounded-2xl bg-white/10 hover:bg-white/20">
                            <svg class="w-9 h-9 text-sky-400 p-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
                            <span class="text-[11px] font-medium text-white">Controls</span>
                        </button>
                        <button data-assistive="screenshot" data-action="Screenshot Saved" class="gaze-target flex flex-col items-center gap-1.5 p-2.5 rounded-2xl bg-white/10 hover:bg-white/20">
                            <svg class="w-9 h-9 text-emerald-400 p-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/></svg>
                            <span class="text-[11px] font-medium text-white">Capture</span>
                        </button>
                        <button data-assistive="pause" data-action="Toggle Gaze Pause" class="gaze-target flex flex-col items-center gap-1.5 p-2.5 rounded-2xl bg-amber-500/15 hover:bg-amber-500/25 border border-amber-400/25">
                            <svg class="w-9 h-9 text-amber-300 p-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            <span id="assistive-pause-label" class="text-[11px] font-medium text-amber-200">Pause Gaze</span>
                        </button>
                        <button data-assistive="volup" data-action="Volume Up 80%" class="gaze-target flex flex-col items-center gap-1.5 p-2.5 rounded-2xl bg-white/10 hover:bg-white/20">
                            <svg class="w-9 h-9 text-amber-300 p-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/></svg>
                            <span class="text-[11px] font-medium text-white">Vol +</span>
                        </button>
                        <button data-assistive="reader" data-action="Open Auto-Scroll Reader" class="gaze-target flex flex-col items-center gap-1.5 p-2.5 rounded-2xl bg-white/10 hover:bg-white/20">
                            <svg class="w-9 h-9 text-purple-300 p-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
                            <span class="text-[11px] font-medium text-white">Reader</span>
                        </button>
                        <button id="close-assistive-btn" data-action="Close Menu" class="gaze-target flex flex-col items-center gap-1.5 p-2.5 rounded-2xl bg-rose-500/20 text-rose-300">
                            <svg class="w-9 h-9 p-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                            <span class="text-[11px] font-medium">Close</span>
                        </button>
                    </div>
                    <div class="text-[10px] text-zinc-400">Dwell or Blink to Trigger Hardware Action</div>
