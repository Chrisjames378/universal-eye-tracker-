            if (el.id === 'kb-page-btn') {
                state.kbPage = state.kbPage === 0 ? 1 : 0;
                renderKeyboardKeys();
                return;
            }

            if (typeText || el.hasAttribute('data-predict')) {
                const out = document.getElementById('typed-output');
                if (el.hasAttribute('data-predict')) {
                    const words = out.textContent.trimEnd().split(' ');
                    words[words.length - 1] = el.getAttribute('data-predict').trim();
                    out.textContent = words.join(' ') + ' ';
                } else {
                    out.textContent += typeText;
                }
                updateWordPredictions();
                return;
