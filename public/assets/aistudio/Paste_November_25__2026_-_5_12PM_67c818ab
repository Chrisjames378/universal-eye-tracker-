        function updateWordPredictions() {
            const text = document.getElementById('typed-output').textContent.trim();
            const lastToken = (text.split(' ').pop() || '').toUpperCase();
            const matches = DICTIONARY.filter(w => w.startsWith(lastToken) && w !== lastToken);
            const suggestions = (matches.length ? matches : ['YES', 'PLEASE', 'THANKS']).slice(0, 3);
            const bar = document.getElementById('predictive-bar');
            bar.innerHTML = '';
            suggestions.forEach(word => {
                const b = document.createElement('button');
                b.setAttribute('data-predict', `${word} `);
                b.className = 'gaze-target py-1.5 px-2 rounded-xl bg-sky-500/15 border border-sky-500/30 text-xs font-semibold text-sky-200 truncate';
                b.textContent = word;
                bar.appendChild(b);
            });
            bindGazeTargets();
        }

        // Draw Dual-Eye Biometric Telemetry Canvas
        function renderTelemetry(time) {
            const w = telemetryCanvas.width / window.devicePixelRatio;
            const h = telemetryCanvas.height / window.devicePixelRatio;
            ctx.clearRect(0, 0, w, h);

            // Subtle Grid Background
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
            ctx.lineWidth = 1;
            for (let x = 0; x < w; x += 24) {
                ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke();
            }
            for (let y = 0; y < h; y += 24) {
                ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke();
            }

            // Draw Left & Right Virtual Eyes tracking irisNorm
            const eyeCenters = [w * 0.32, w * 0.68];
            const eyeY = h * 0.5;
            const offsetX = (state.irisNorm.x - 0.5) * 26;
            const offsetY = (state.irisNorm.y - 0.5) * 14;

            eyeCenters.forEach((cx) => {
                // Almond Sclera Outline (Pinches closed dynamically when blinking)
                const lidOpen = state.isBlinking ? 3 : 26;
                ctx.beginPath();
                ctx.moveTo(cx - 44, eyeY);
                ctx.quadraticCurveTo(cx, eyeY - lidOpen, cx + 44, eyeY);
                ctx.quadraticCurveTo(cx, eyeY + lidOpen, cx - 44, eyeY);
                ctx.strokeStyle = state.isBlinking ? '#fbbf24' : 'rgba(56, 189, 248, 0.5)';
                ctx.lineWidth = 1.5;
                ctx.stroke();
                ctx.fillStyle = 'rgba(14, 165, 233, 0.06)';
                ctx.fill();

                if (!state.isBlinking) {
                    // Iris Ring
                    const ix = cx + offsetX;
                    const iy = eyeY + offsetY;
                    ctx.beginPath();
                    ctx.arc(ix, iy, 13, 0, Math.PI * 2);
                    ctx.fillStyle = 'rgba(56, 189, 248, 0.25)';
                    ctx.fill();
                    ctx.strokeStyle = '#38bdf8';
                    ctx.lineWidth = 1.5;
                    ctx.stroke();

                    // Pupil
                    ctx.beginPath();
                    ctx.arc(ix, iy, 5.5, 0, Math.PI * 2);
                    ctx.fillStyle = '#ffffff';
                    ctx.fill();

                    // Gaze Ray Vector
                    ctx.beginPath();
                    ctx.moveTo(ix, iy);
                    ctx.lineTo(ix + offsetX * 1.4, iy + offsetY * 1.4);
                    ctx.strokeStyle = 'rgba(56, 189, 248, 0.8)';
                    ctx.lineWidth = 1.5;
                    ctx.stroke();
                }
            });
        }

        // Render Saccade Trail & Fixation Heatmap Overlay on iPhone Screen
        function renderHeatmapOverlay() {
            if (!state.heatmapEnabled) return;
            const phoneRect = heatmapCanvas.parentElement.getBoundingClientRect();
            const w = phoneRect.width;
            const h = phoneRect.height;
            hCtx.clearRect(0, 0, w, h);

            // Record gaze point if inside iPhone bounds
            if (
                state.smoothGaze.x >= phoneRect.left &&
                state.smoothGaze.x <= phoneRect.right &&
                state.smoothGaze.y >= phoneRect.top &&
                state.smoothGaze.y <= phoneRect.bottom
            ) {
                state.gazeTrail.push({
                    x: state.smoothGaze.x - phoneRect.left,
                    y: state.smoothGaze.y - phoneRect.top
                });
                if (state.gazeTrail.length > 45) state.gazeTrail.shift();
            }

            // Draw Fixation Heatmap Nodes
            state.fixationPoints.forEach(pt => {
                const grad = hCtx.createRadialGradient(pt.x, pt.y, 2, pt.x, pt.y, pt.r);
                grad.addColorStop(0, 'rgba(244, 63, 94, 0.55)');
                grad.addColorStop(0.5, 'rgba(251, 191, 36, 0.25)');
                grad.addColorStop(1, 'rgba(56, 189, 248, 0)');
                hCtx.fillStyle = grad;
                hCtx.beginPath();
                hCtx.arc(pt.x, pt.y, pt.r, 0, Math.PI * 2);
                hCtx.fill();
            });

            // Draw Saccade Trajectory Path
            if (state.gazeTrail.length > 1) {
                hCtx.beginPath();
                hCtx.moveTo(state.gazeTrail[0].x, state.gazeTrail[0].y);
                for (let i = 1; i < state.gazeTrail.length; i++) {
                    hCtx.lineTo(state.gazeTrail[i].x, state.gazeTrail[i].y);
                }
                hCtx.strokeStyle = 'rgba(192, 132, 252, 0.65)';
                hCtx.lineWidth = 2;
                hCtx.stroke();
            }
        }

        // Edge Auto-Scroll Handler for Safari Reader View
        function handleGazeAutoScroll() {
            const safariView = document.getElementById('view-safari');
            if (safariView.classList.contains('hidden')) return;

            const scrollContainer = document.getElementById('safari-scroll-container');
            const zoneUp = document.getElementById('scroll-zone-up').getBoundingClientRect();
            const zoneDown = document.getElementById('scroll-zone-down').getBoundingClientRect();
            const gx = state.smoothGaze.x;
            const gy = state.smoothGaze.y;

            if (gx >= zoneUp.left && gx <= zoneUp.right && gy >= zoneUp.top && gy <= zoneUp.bottom) {
                scrollContainer.scrollTop -= 4.5;
                document.getElementById('scroll-zone-badge').textContent = '▲ Auto-Scrolling Up';
            } else if (gx >= zoneDown.left && gx <= zoneDown.right && gy >= zoneDown.top && gy <= zoneDown.bottom) {
                scrollContainer.scrollTop += 4.5;
                document.getElementById('scroll-zone-badge').textContent = '▼ Auto-Scrolling Down';
            } else {
                document.getElementById('scroll-zone-badge').textContent = 'Look Top/Bottom to Scroll';
            }
        }

        // Main Real-Time Gaze & Dwell Physics Loop (60Hz)
        let lastFrame = performance.now();
        let fpsFrames = 0;
        let fpsLastSample = performance.now();

        function updateLoop(now) {
            const dt = now - lastFrame;
            lastFrame = now;

            fpsFrames++;
            if (now - fpsLastSample >= 500) {
                state.fpsEstimate = Math.round((fpsFrames * 1000) / (now - fpsLastSample));
                document.getElementById('fps-counter').textContent = `${state.fpsEstimate} FPS`;
                fpsFrames = 0;
                fpsLastSample = now;
            }

            // Add subtle physiological ocular micro-tremor in sim mode
            const tremorX = state.mode === 'sim' ? Math.sin(now * 0.025) * 1.8 : 0;
            const tremorY = state.mode === 'sim' ? Math.cos(now * 0.031) * 1.8 : 0;

            let targetX = state.rawGaze.x + tremorX;
            let targetY = state.rawGaze.y + tremorY;

            // Hit-testing for iOS Gaze Targets
            let hoveredTarget = null;
            const targets = document.querySelectorAll('.gaze-target');
            targets.forEach(el => {
                if (el.offsetParent === null) return; // Skip hidden elements
                const rect = el.getBoundingClientRect();
                const pad = 8; // Generous hit padding like iOS Accessibility
                if (
                    targetX >= rect.left - pad &&
                    targetX <= rect.right + pad &&
                    targetY >= rect.top - pad &&
                    targetY <= rect.bottom + pad
                ) {
                    hoveredTarget = el;
                }
            });

            // Magnetic Snap-to-Item (iOS Accessibility Signature Feature)
            if (hoveredTarget && state.snapEnabled && !state.gazePaused) {
                const rect = hoveredTarget.getBoundingClientRect();
                const centerX = rect.left + rect.width / 2;
                const centerY = rect.top + rect.height / 2;
                targetX = targetX * 0.35 + centerX * 0.65;
                targetY = targetY * 0.35 + centerY * 0.65;
            }

            // Exponential Low-Pass Smoothing Filter
            state.smoothGaze.x += (targetX - state.smoothGaze.x) * state.smoothingFactor;
            state.smoothGaze.y += (targetY - state.smoothGaze.y) * state.smoothingFactor;

            // Position Floating Reticle
            reticle.style.transform = `translate3d(${state.smoothGaze.x}px, ${state.smoothGaze.y}px, 0)`;
            reticle.style.opacity = state.gazePaused ? '0.4' : '1';

            // Update Telemetry Readouts
            const pctX = Math.min(100, Math.max(0, (state.smoothGaze.x / window.innerWidth) * 100));
            const pctY = Math.min(100, Math.max(0, (state.smoothGaze.y / window.innerHeight) * 100));
            document.getElementById('stat-x').textContent = `${pctX.toFixed(1)}%`;
            document.getElementById('stat-y').textContent = `${pctY.toFixed(1)}%`;

            // Handle Dwell-to-Click State Machine (suspended while Gaze Pause is active)
            if (state.gazePaused) {
                if (state.currentHoveredEl) {
                    state.currentHoveredEl.classList.remove('gaze-hovered');
                    state.currentHoveredEl = null;
                }
                dwellCircle.style.strokeDashoffset = CIRCUMFERENCE;
            } else if (hoveredTarget !== state.currentHoveredEl) {
                if (state.currentHoveredEl) {
                    state.currentHoveredEl.classList.remove('gaze-hovered');
                }
                state.currentHoveredEl = hoveredTarget;
                state.dwellStartTime = hoveredTarget ? now : null;
                state.dwellTriggered = false;
                dwellCircle.style.strokeDashoffset = CIRCUMFERENCE;

                if (hoveredTarget) {
                    hoveredTarget.classList.add('gaze-hovered');
                    playFeedbackSound('hover');
                }
            } else if (hoveredTarget && state.dwellEnabled && !state.dwellTriggered && !state.isCalibrating) {
                const elapsed = now - state.dwellStartTime;
                const progress = Math.min(1, elapsed / state.dwellDuration);
                dwellCircle.style.strokeDashoffset = CIRCUMFERENCE * (1 - progress);

                if (progress >= 1) {
                    state.dwellTriggered = true;
                    dwellCircle.style.strokeDashoffset = CIRCUMFERENCE;
                    handleTargetActivation(hoveredTarget);
                }
            }

            handleGazeAutoScroll();
            renderHeatmapOverlay();
            renderTelemetry(now);
            requestAnimationFrame(updateLoop);
        }

        // Restore saved preferences and start simulation loop
        loadPreferences();
        reticle.classList.remove('hidden');
        requestAnimationFrame(updateLoop);
    </script>
</body>
</html>